# KisanSaathi Environment Configuration Template
# Copy this file to .env or .env.local to configure external API keys.

# Optional: National Agmarknet / data.gov.in Mandi Price API Access Key
# When left empty, KisanSaathi operates in full Transparent Demonstration Mode (clearly badged as DEMO).
VITE_AGMARKNET_API_KEY=
VITE_DATA_GOV_IN_API_KEY=

# Optional: OpenStreetMap / CartoDB custom tile provider URL (defaults to CartoDB Positron / OSM)
VITE_MAP_TILES_URL=

# Application Mode: development | staging | production
VITE_APP_ENV=development
